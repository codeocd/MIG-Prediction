<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="draw.io" version="22.0.0">
  <diagram id="pi-etd-net-framework" name="PI-ETD-Net Framework">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="Fig.3 PI-ETD-Net Two-Stage Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <!-- Input x -->
        <mxCell id="input_x" value="Input x&#xa;(11-dim geometric&#xa;parameters)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="140" height="70" as="geometry" />
        </mxCell>
        <!-- Addition node -->
        <mxCell id="add_node" value="+" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="315" width="40" height="40" as="geometry" />
        </mxCell>
        <!-- Stage 1 Box -->
        <mxCell id="stage1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="370" y="200" width="450" height="280" as="geometry" />
        </mxCell>
        <mxCell id="stage1_title" value="Stage 1: Cold-State Surrogate f_cold" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="350" height="25" as="geometry" />
        </mxCell>
        <!-- Residual MLP -->
        <mxCell id="res_mlp" value="Residual MLP&#xa;(3 blocks, 128-dim)&#xa;&#xa;BatchNorm → ResBlock×3&#xa;(Linear→LN→SiLU→Linear+Skip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="250" width="200" height="100" as="geometry" />
        </mxCell>
        <!-- Multi-task heads -->
        <mxCell id="head_alpha" value="Head: α" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="250" width="80" height="35" as="geometry" />
        </mxCell>
        <mxCell id="head_delta" value="Head: δ_α" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="295" width="80" height="35" as="geometry" />
        </mxCell>
        <mxCell id="head_rg" value="Head: R_g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="340" width="80" height="35" as="geometry" />
        </mxCell>
        <mxCell id="head_dr" value="Head: Δr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="385" width="80" height="35" as="geometry" />
        </mxCell>
        <!-- Multi-task head label -->
        <mxCell id="mt_label" value="Multi-Task&#xa;Heads" style="text;html=1;align=center;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="425" width="80" height="30" as="geometry" />
        </mxCell>
        <!-- Arrows from ResBlock to heads -->
        <mxCell id="arr_h1" style="rounded=0;orthogonalLoop=1;strokeColor=#388E3C;" edge="1" parent="1" source="res_mlp" target="head_alpha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_h2" style="rounded=0;orthogonalLoop=1;strokeColor=#388E3C;" edge="1" parent="1" source="res_mlp" target="head_delta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_h3" style="rounded=0;orthogonalLoop=1;strokeColor=#388E3C;" edge="1" parent="1" source="res_mlp" target="head_rg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_h4" style="rounded=0;orthogonalLoop=1;strokeColor=#388E3C;" edge="1" parent="1" source="res_mlp" target="head_dr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Output y_cold -->
        <mxCell id="output_y" value="y_cold&#xa;(α, δ_α, R_g, Δr)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEDC8;strokeColor=#558B2F;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="300" width="130" height="60" as="geometry" />
        </mxCell>
        <!-- Arrow from heads to output -->
        <mxCell id="arr_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="head_rg" target="output_y">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Stage 2 Box: ETD Module -->
        <mxCell id="stage2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="stage2_title" value="Stage 2: ETD Module g(c; θ_g)" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#BF360C;" vertex="1" parent="1">
          <mxGeometry x="130" y="560" width="290" height="25" as="geometry" />
        </mxCell>
        <!-- Operating conditions input -->
        <mxCell id="cond_input" value="Operating Conditions c&#xa;(V_a, I_b, T_cathode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="600" width="150" height="50" as="geometry" />
        </mxCell>
        <!-- ETD MLP -->
        <mxCell id="etd_mlp" value="MLP&#xa;3→32→32→11&#xa;+ tanh + σ_scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#EF6C00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="600" width="120" height="50" as="geometry" />
        </mxCell>
        <!-- ETD output -->
        <mxCell id="etd_output" value="Δx_ETD&#xa;(11-dim offset)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="670" width="120" height="40" as="geometry" />
        </mxCell>
        <!-- Arrows in ETD module -->
        <mxCell id="arr_etd1" style="rounded=0;orthogonalLoop=1;strokeColor=#E65100;" edge="1" parent="1" source="cond_input" target="etd_mlp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_etd2" style="rounded=0;orthogonalLoop=1;strokeColor=#E65100;" edge="1" parent="1" source="etd_mlp" target="etd_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Connection: ETD output to addition node -->
        <mxCell id="arr_etd_to_add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;strokeColor=#E65100;strokeWidth=2;dashed=1;" edge="1" parent="1" source="etd_output" target="add_node">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="690" />
              <mxPoint x="280" y="450" />
              <mxPoint x="280" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Arrow from input to add -->
        <mxCell id="arr_x_to_add" style="rounded=0;orthogonalLoop=1;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1" source="input_x" target="add_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Arrow from add to stage 1 -->
        <mxCell id="arr_add_to_s1" style="rounded=0;orthogonalLoop=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="add_node" target="res_mlp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="add_label" value="x + Δx_ETD" style="text;html=1;align=center;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="80" height="20" as="geometry" />
        </mxCell>
        <!-- Physics Loss Branch -->
        <mxCell id="phys_loss_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="600" y="560" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="phys_title" value="Physics Loss Branch (物理约束)" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="650" y="570" width="280" height="25" as="geometry" />
        </mxCell>
        <mxCell id="loss_busch" value="L_Busch: R_g² · B₀ ≈ R_cat² · B_c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="600" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="loss_energy" value="L_energy: ½m(v⊥²+v∥²) ≈ eU_a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="635" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="loss_mono" value="L_α-mono: ∂α/∂V_a &lt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="670" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="loss_thick" value="L_thickness: Δr ≥ geometric lower bound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="705" width="220" height="28" as="geometry" />
        </mxCell>
        <!-- Data Loss -->
        <mxCell id="data_loss" value="L_MSE&#xa;(Data Loss)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="620" width="100" height="50" as="geometry" />
        </mxCell>
        <!-- Total loss -->
        <mxCell id="total_loss" value="L_total = L_MSE + Σλ_k · L_k^phys" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="750" width="300" height="25" as="geometry" />
        </mxCell>
        <!-- Arrow from output to losses -->
        <mxCell id="arr_to_phys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=1;dashed=1;" edge="1" parent="1" source="output_y" target="phys_loss_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_to_data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;strokeColor=#6A1B9A;strokeWidth=1;dashed=1;" edge="1" parent="1" source="output_y" target="data_loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
